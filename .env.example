# Copy to `.env` and fill in your key (`.env` is gitignored).
# Get a key: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Comma-separated pools. The guard rotates on HTTP 429/403, then fails over
# Grok -> Gemini -> the local deterministic template.
# GROK_API_KEYS=key1,key2,key3
# GEMINI_API_KEYS=keyA,keyB
# GROK_MODEL=grok-2
# GEMINI_MODEL=gemini-2.0-flash
# LLM_MIN_INTERVAL_SEC=0.75
# LLM_KEY_COOLDOWN_SEC=60
